{
  "kind": "document_search",
  "version": "0.1.0",
  "title": "Document Search",
  "description": "Search a persistent local text corpus and return relevant excerpts with their source references.",
  "repository_url": "https://github.com/HackInvent/bloxmith-document-search",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Python SQLite runtime built with the FTS5 module; no downloadable extensions are loaded."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "documents",
        "title": "documents",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "query",
        "title": "query",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 3,
        "name": "command",
        "title": "command",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "matches",
        "title": "matches",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "status",
        "title": "status",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "corpus": "default",
    "match_mode": "all_terms",
    "max_results": 10,
    "max_documents": 1000,
    "max_sections": 10000,
    "max_characters": 10000000,
    "max_input_bytes": 1048576,
    "timeout_sec": 10
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "file_browser": false,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
